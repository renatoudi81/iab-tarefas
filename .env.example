# ============================================
# Firebase — Cliente (públicas, expostas ao browser)
# Copie do Firebase Console → Configurações → Seus apps → SDK web
# ============================================
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSy..."
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="seu-projeto"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="seu-projeto.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abc123"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ============================================
# Firebase — Admin SDK (server-only, NUNCA expor)
# Console → Configurações → Contas de serviço → Gerar nova chave privada
# ============================================
FIREBASE_PROJECT_ID="seu-projeto"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================
# Vercel Blob — para upload de anexos
# Painel da Vercel → Storage → Connect a Database → Blob
# ============================================
BLOB_READ_WRITE_TOKEN="vercel_blob_..."
